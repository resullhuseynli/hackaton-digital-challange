# Copy to .env and adjust. docker compose reads .env automatically for interpolation.

# --- Infrastructure ---
POSTGRES_USER=baku
POSTGRES_PASSWORD=baku
POSTGRES_DB=baku
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
WEB_WORKERS=4

# Used when running the API outside docker:
DATABASE_URL=postgresql+asyncpg://baku:baku@localhost:5432/baku
REDIS_URL=redis://localhost:6379/0

# --- Security ---
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Road graph: synthetic (offline) | osm (needs INSTALL_OSMNX=true + internet) ---
GRAPH_SOURCE=synthetic
INSTALL_OSMNX=false

# --- Crisis / routing thresholds ---
CLUSTER_RADIUS_M=500
CLUSTER_WINDOW_MIN=5
CLUSTER_MIN_DISTINCT=4
REROUTE_OCCUPANCY_PCT=90
RED_ALERT_OCCUPANCY_PCT=95
SOS_COOLDOWN_SEC=60
NEAREST_SEARCH_RADIUS_M=5000
# congestion_factor at/above which a "congested" road triggers rerouting
CONGESTION_REROUTE_FACTOR=2.0
# --- External map & routing API (OSRM-compatible) + resilience ---
# empty = disabled (local road graph is primary). Compose default: the bundled mock provider.
EXTERNAL_ROUTING_URL=http://routing-mock:8080
EXTERNAL_ROUTING_PROFILE=foot
EXTERNAL_ROUTING_TIMEOUT_SEC=5
# fault-injection endpoint used by POST /sim/routing-fault (mock provider only)
EXTERNAL_ROUTING_FAULT_URL=http://routing-mock:8080/__fault
ROUTING_CB_FAILURE_THRESHOLD=3
ROUTING_CB_RESET_SEC=30
ROUTE_CACHE_TTL_SEC=21600

WALK_SPEED_KMH=5
# speed used for step-free routes of persons with reduced mobility
ACCESSIBLE_WALK_SPEED_KMH=3.5
BRIGADE_SPEED_KMH=40

# --- Throughput (best measured configuration: 4 workers, pool 6+3, separate worker process) ---
DB_POOL_SIZE=6
DB_MAX_OVERFLOW=3
REDIS_MAX_CONNECTIONS=64
CRISIS_ASYNC=true
# consumers inside each API worker (compose sets 0 because the `worker` service consumes)
CRISIS_CONSUMERS_PER_WORKER=1
WORKER_CONSUMERS=4

# --- SOS flood / spam protection ---
RATE_LIMIT_ENABLED=true
RATE_SOS_PER_IP_PER_MIN=30
RATE_REGISTER_PER_IP_PER_MIN=20
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_SEC=900
SPAM_DUP_WINDOW_SEC=120
SPAM_NEW_DEVICE_SEC=600
SPAM_REG_PER_IP_10MIN=15
SPAM_FLOOD_SOS_PER_10S=100

# --- JWT claims ---
JWT_ISSUER=baku-dispatch
JWT_AUDIENCE=dispatch-panel
